# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Xcode 15+ + Widget Extension (Live Activity) cycle fix nuclear: hace que
# CocoaPods NO escriba input/output paths en los scripts inyectados. Sin esas
# declaraciones, Xcode no puede inferir el ciclo
# `[CP] Embed Pods Frameworks ↔ [CP] Copy Pods Resources ↔ .appex copy`.
# Trade-off: los scripts corren en cada build (~1s c/u).
install! 'cocoapods', :disable_input_output_paths => true

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Fix Xcode 15+ build cycle con Widget Extension (`Cycle inside
      # Runner; building could produce unreliable results`). El sandboxing
      # de scripts agrega dependencias implícitas entre `[CP] Embed Pods
      # Frameworks`, `Thin Binary` y la copia del `.appex` a `PlugIns/`.
      # Desactivarlo le da a Xcode el orden lineal que esperaba.
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end

  # El cycle vive principalmente en el Runner project (Pods sólo aporta
  # scripts inyectados). Replicamos el mismo flag ahí.
  runner_project_path = File.expand_path('Runner.xcodeproj', __dir__)
  runner_project = Xcodeproj::Project.open(runner_project_path)
  runner_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end

  # Fix Xcode 15+ build cycle con Widget Extension + CocoaPods:
  #
  # Xcode infiere dependencias por dos vías:
  # 1. Los input/output paths declarados por CocoaPods en los `[CP]`
  #    scripts → ya resuelto por `disable_input_output_paths` global.
  # 2. El ORDEN de las build phases: si `Thin Binary` queda DESPUÉS del
  #    copy del `.appex` a `Runner.app/PlugIns/`, Xcode genera un ciclo
  #    porque el ProcessInfoPlistFile valida que las extensiones existan.
  #
  # Solución de orden: enforzamos que Thin Binary corra TEMPRANO (justo
  # después del compile/link) y que "Embed Foundation Extensions" (copy
  # del .appex) corra ÚLTIMO. Como CocoaPods regenera el orden en cada
  # `pod install`, hay que aplicarlo siempre desde acá.
  runner_target = runner_project.targets.find { |t| t.name == 'Runner' }
  if runner_target
    # Marcar [CP] scripts como always-out-of-date por las dudas (no daña
    # nada incluso si disable_input_output_paths ya está activo).
    runner_target.build_phases.each do |phase|
      next unless phase.respond_to?(:shell_script)
      next unless phase.display_name =~ /\[CP\] (Embed Pods Frameworks|Copy Pods Resources)/
      phase.always_out_of_date = '1'
    end

    phases = runner_target.build_phases

    # 1. Mover Thin Binary justo después de Link Binary With Libraries.
    thin_binary = phases.find do |p|
      p.respond_to?(:shell_script) && p.display_name == 'Thin Binary'
    end
    link_idx = phases.index do |p|
      p.is_a?(Xcodeproj::Project::Object::PBXFrameworksBuildPhase)
    end
    if thin_binary && link_idx
      phases.delete(thin_binary)
      phases.insert(link_idx + 1, thin_binary)
    end

    # 2. Mover "Embed Foundation Extensions" (copy phase a PlugIns/) al
    #    final de todas las phases.
    embed_ext = phases.find do |p|
      p.is_a?(Xcodeproj::Project::Object::PBXCopyFilesBuildPhase) &&
        (p.symbol_dst_subfolder_spec == :plug_ins ||
         p.dst_subfolder_spec == '13')
    end
    if embed_ext
      phases.delete(embed_ext)
      phases << embed_ext
    end
  end

  runner_project.save
end
