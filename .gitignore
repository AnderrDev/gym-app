# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Sidecars del `dart compile js` (web/drift_worker.dart.js.{deps,map}).
# El .js compilado SÍ va al repo; los sidecars no porque se regeneran y
# Flutter Web los empaqueta al build/web sin necesidad.
web/*.js.deps
web/*.js.map

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
